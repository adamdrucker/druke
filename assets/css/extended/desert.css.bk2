/* ---------- FONTS: change these two lines to try others ---------- */
:root {
  --font-body: 'Avenir Next', 'Avenir', 'Helvetica Neue', sans-serif;
  --font-head: 'Baskerville', 'Palatino', Georgia, serif;
}

/* ---------- LIGHT: sand, faded crimson, sage, turquoise ---------- */
:root {
  --theme: #F5E9DA;        /* your sand */
  --entry: #FBF3E8;
  --primary: #8E3B34;      /* deep faded crimson: headings, titles */
  --secondary: #6B7F67;    /* sage: dates, meta text */
  --tertiary: #DDE3D0;     /* pale sage: hover/tags */
  --content: #2E2420;      /* body text */
  --border: #CFD6C1;       /* sage-tinted lines */
  --code-bg: #E8E9D6;
  --crimson: #B2554B;
  --sage: #8FA38A;
  --turquoise: #0F7F78;
}

/* ---------- DARK: desert at dusk ---------- */
.dark {
  --theme: #1E1814;
  --entry: #2A211B;
  --primary: #E08B7E;
  --secondary: #A9BCA3;
  --tertiary: #34402F;
  --content: #EADCCB;
  --border: #3C4A38;
  --code-bg: #2C2A20;
  --crimson: #E08B7E;
  --sage: #A9BCA3;
  --turquoise: #4FD1C0;
}

body { font-family: var(--font-body); background: var(--theme); }
h1, h2, h3, h4, .logo a, .post-title { font-family: var(--font-head); }
h1, h2, h3 { color: var(--primary); }
::selection { background: var(--turquoise); color: #fff; }

/* header: sage band on top, crimson underline on the active page */
.header { border-top: 5px solid var(--sage); border-bottom: 1px solid var(--border); }
.menu a { letter-spacing: .06em; text-transform: uppercase; font-size: 14px; }
.menu a:hover { color: var(--turquoise); }
.menu .active { color: var(--crimson); border-bottom: 2px solid var(--crimson); }

/* links turquoise, hover crimson */
.post-content a { color: var(--turquoise); box-shadow: none; border-bottom: 1px solid currentColor; }
.post-content a:hover { color: var(--crimson); }

/* cards */
.post-entry { border: 1px solid var(--border); border-left: 4px solid var(--sage); }
.post-entry:hover { border-left-color: var(--turquoise); }

/* homepage buttons: crimson, turquoise on hover */
.button { background: var(--crimson); color: #FBF3E8; border: 0; }
.button:hover { background: var(--turquoise); }

/* tags + code */
.post-tags a { background: var(--tertiary); color: var(--primary); }
pre, code { border-radius: 6px; }
